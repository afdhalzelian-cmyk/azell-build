@@ -0,0 +1,39 @@
+const { readFileSync } = require('node:fs')
+const { join } = require('node:path')
+const { parse } = require('yaml')
+
+const base = parse(readFileSync(join(__dirname, 'electron-builder.yml'), 'utf8'))
+delete base.protocols
+
+module.exports = {
+  ...base,
+  extends: null,
+  appId: 'com.azell.personalassistant',
+  productName: 'Azell Personal Assistant',
+  extraMetadata: {
+    ...base.extraMetadata,
+    name: 'azell-personal-assistant',
+    productName: 'Azell Personal Assistant'
+  },
+  directories: {
+    ...base.directories,
+    output: 'dist-azell'
+  },
+  publish: null,
+  win: {
+    ...base.win,
+    executableName: 'Azell',
+    artifactName: 'Azell-${version}-${arch}-setup.${ext}',
+    verifyUpdateCodeSignature: false
+  },
+  nsis: {
+    ...base.nsis,
+    guid: 'e2221d05-252c-4407-a312-b01dc62a7104',
+    artifactName: 'Azell-${version}-${arch}-setup.${ext}',
+    deleteAppDataOnUninstall: false
+  },
+  portable: {
+    ...base.portable,
+    artifactName: 'Azell-${version}-${arch}-portable.${ext}'
+  }
+}
