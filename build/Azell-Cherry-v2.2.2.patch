+++ b/src/main/core/productIdentity.ts
@@ -0,0 +1,8 @@
+import { app } from 'electron'
+
+export const AZELL_PRODUCT_NAME = 'Azell Personal Assistant'
+export const AZELL_APPLICATION_ID = 'com.azell.personalassistant'
+
+export function isAzellBuild(): boolean {
+  return app.isPackaged && (app.name === AZELL_PRODUCT_NAME || app.name === 'azell-personal-assistant')
+}
